# Server
PORT=4100
NODE_ENV=development
LOG_LEVEL=debug

# Provider: twilio | meta
BOT_PROVIDER=twilio

# Backend mode: mock for local bot testing, http when gridee-backend is ready
BACKEND_MODE=mock
GRIDEE_BACKEND_BASE_URL=http://localhost:4000/internal
GRIDEE_BACKEND_API_KEY=dev-secret-key

# Session
SESSION_TTL_SECONDS=1800
IDEMPOTENCY_TTL_SECONDS=86400

# Twilio WhatsApp Sandbox
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
# twiml is easiest for incoming sandbox replies. api is needed for outbound/push notifications.
TWILIO_REPLY_MODE=twiml

# Meta WhatsApp Cloud API
META_VERIFY_TOKEN=
META_APP_SECRET=
META_ACCESS_TOKEN=
META_PHONE_NUMBER_ID=
META_GRAPH_API_VERSION=v22.0

# Business rules for mock mode
GRIDEE_KWH_RATE_NAIRA=48
GRIDEE_MIN_TOPUP_NAIRA=2000
MOCK_OTP_CODE=123456
