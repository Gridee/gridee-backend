{
  "name": "gridee-backend",
  "version": "1.0.0",
  "description": "Core API server for Gridee — a solar energy tokenisation platform",
  "main": "node dist/src/index.js",
  "scripts": {
    "start": "node dist/src/index.js",
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "build": "tsc",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "db:migrate": "knex migrate:latest",
    "db:rollback": "knex migrate:rollback",
    "lint": "tsc --noEmit"
  },
  "keywords": [
    "solar",
    "energy",
    "web3",
    "tokenization"
  ],
  "author": "Gridee Team",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "axios": "^1.15.2",
    "cors": "^2.8.5",
    "dotenv": "^17.4.2",
    "ethers": "^6.16.0",
    "express": "^5.2.1",
    "express-rate-limit": "^7.5.1",
    "flutterwave-node-v3": "^1.3.2",
    "ioredis": "^5.10.1",
    "jsonwebtoken": "^9.0.3",
    "knex": "^3.2.9",
    "node-cron": "^3.0.3",
    "pg": "^8.20.0",
    "pino": "^10.0.0",
    "pino-http": "^10.4.0",
    "redis": "^5.0.0",
    "twilio": "^5.0.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^20.17.0",
    "@types/node-cron": "^3.0.11",
    "@types/pg": "^8.20.0",
    "@types/supertest": "^7.0.0",
    "pino-pretty": "^13.0.0",
    "supertest": "^7.0.0",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.7.0",
    "vitest": "^4.1.5"
  }
}
